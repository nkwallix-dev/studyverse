// StudyVerse security lockdown.
// CRITICAL: this file must be deployed to Firebase > Firestore Database > Rules.
// The static website cannot deploy these rules on its own.
//
// Private /users saves remain editable by their authenticated owner for backup/sync.
// Their JSON profile (including XP and TastyTokens) is CLIENT-UNVERIFIED DATA.
// Never copy those numeric values directly into any public leaderboard.
//
// /publicProfiles was an unverified legacy leaderboard. It is now locked.
// /verifiedProfiles is a separate SERVER-ONLY collection for a future scoring
// service. Firebase Admin SDK / Cloud Functions bypass Firestore Security Rules
// and must validate answers, reward idempotency and display names themselves.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt'])
        && request.resource.data.keys().hasAll(['profile', 'updatedAt'])
        && request.resource.data.profile is string
        && request.resource.data.profile.size() < 750000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Legacy entries may contain forged XP/levels or offensive nicknames.
    // Prevent all client reads/writes while admins review existing records.
    match /publicProfiles/{userId} {
      allow read, write: if false;
    }

    // Only a trusted backend may create authoritative rankings.
    // No client, including the owner, can write or forge the verified flag.
    match /verifiedProfiles/{userId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
