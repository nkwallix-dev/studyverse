// Studyverse Firestore rules
// Private progress is owner-only and UNVERIFIED.
// Friend cards are social data only; never trust legacy level or XP.
// Verified leaderboard data and moderation notices are admin-only writes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt'])
        && request.resource.data.keys().hasAll(['profile', 'updatedAt'])
        && request.resource.data.profile is string
        && request.resource.data.profile.size() < 750000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    function validFriendProfile() {
      return request.resource.data.keys().hasAll(['nickname', 'avatar', 'selectedTitle', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() > 0
        && request.resource.data.avatar.size() <= 20
        && request.resource.data.selectedTitle is string
        && request.resource.data.selectedTitle.size() > 0
        && request.resource.data.selectedTitle.size() <= 80
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicProfiles/{userId} {
      // Signed-in classmates can view friend cards, never legacy ranks.
      allow get, list: if request.auth != null;
      // New cards contain only display fields and no scores.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'avatar', 'selectedTitle', 'updatedAt'])
        && validFriendProfile();
      // Updates cannot modify legacy level/title or any other admin fields.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nickname', 'avatar', 'selectedTitle', 'updatedAt'])
        && validFriendProfile();
      allow delete: if false;
    }

    match /accountNotices/{userId} {
      // Moderation notices are created/updated by administrators only.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /accountNoticeAcks/{userId} {
      // Recipient-owned acknowledgement; this is not proof of guilt.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['noticeId','acknowledgedAt'])
        && request.resource.data.keys().hasAll(['noticeId','acknowledgedAt'])
        && request.resource.data.noticeId is string
        && request.resource.data.noticeId.matches('^[a-z0-9][a-z0-9-]{4,79}$')
        && request.resource.data.acknowledgedAt is timestamp;
    }

    match /verifiedProfiles/{userId} {
      allow get, list: if request.auth != null;
      // Only trusted backend credentials can write verified ranks.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
